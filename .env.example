# Copiar a .env y ajustar si hace falta. Valores solo para desarrollo local.

# PostgreSQL (auth, ordenes, analitica)
POSTGRES_DB=ecommerce
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_PORT=5433

# MongoDB (catalogo)
MONGO_USER=admin
MONGO_PASSWORD=admin
MONGO_PORT=27017
MONGO_URI=mongodb://catalogo:catalogo@mongo:27017/catalogo
CATALOGO_PORT=3000

# Redis (auth)
REDIS_PASSWORD=redis
REDIS_PORT=6379

# Clave para firmar los JWT (auth la usa para firmar, los demás para verificar)
JWT_SECRET=cambia-esto-por-una-clave-larga

# otp: clave para guardar los códigos como HMAC en Redis (distinta de JWT_SECRET)
OTP_SECRET=cambia-esto-por-otra-clave-larga

# Correo de los códigos. Por defecto Mailpit (bandeja de pruebas en http://localhost:8025).
# Para enviar correos reales, usar un servidor SMTP en el puerto 587, ej. Gmail:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=tu@gmail.com
#   SMTP_PASSWORD=<contraseña de aplicación>  SMTP_FROM=ECOMMERCE <tu@gmail.com>
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ECOMMERCE <no-responder@ecommerce.local>
MAILPIT_PORT=8025
